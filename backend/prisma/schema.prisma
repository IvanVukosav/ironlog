generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workout {
  id        Int        @id @default(autoincrement())
  date      DateTime
  name      String?
  notes     String?
  // Set when the workout was loaded from a program; used to suggest the next day.
  programId   Int?
  programWeek Int?
  programDay  Int?
  exercises Exercise[]

  @@index([date])
}

// Children go with their parent (onDelete: Cascade), so deleting a workout, a meal or a template
// is one call and one transaction. SQLite does not index foreign keys on its own.
model Exercise {
  id             Int     @id @default(autoincrement())
  name           String
  order          Int     @default(0)
  supersetGroup  String?
  notes          String?
  workoutId      Int
  workout        Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets           Set[]

  @@index([workoutId])
  @@index([name])
}

model Set {
  id         Int      @id @default(autoincrement())
  weight     Float
  reps       Int
  rpe        Float?
  order      Int      @default(0)
  isWarmup   Boolean  @default(false)
  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

model NutritionDay {
  id    Int    @id @default(autoincrement())
  date  DateTime @unique
  meals Meal[]
}

model Meal {
  id             Int          @id @default(autoincrement())
  name           String
  nutritionDayId Int
  nutritionDay   NutritionDay @relation(fields: [nutritionDayId], references: [id], onDelete: Cascade)
  items          FoodItem[]

  @@index([nutritionDayId])
}

model FoodItem {
  id      Int    @id @default(autoincrement())
  name    String
  kcal    Float
  protein Float
  carbs   Float
  fat     Float
  mealId  Int
  meal    Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

model Settings {
  id                  Int     @id @default(1)
  showWorkoutWidget   Boolean @default(true)
  showNutritionWidget Boolean @default(true)
  showPrWidget        Boolean @default(true)
  kcalGoal            Int     @default(2500)
  proteinGoal         Int     @default(180)
  trainingsPerWeek    Int     @default(4)
  carbsGoal  Int @default(250)
  fatGoal    Int @default(80)
  exercisePickerMode String @default("chips")
  showE1rm   Boolean @default(true)
  e1rmFormula String @default("brzycki")
  language   String @default("hr")
  theme      String @default("auto")
  template   String @default("moderna")
  sex              String  @default("male")
  squatExercise    String?
  benchExercise    String?
  deadliftExercise String?
  // JSON array of exercise names shown at the top of Stats; empty means "most trained".
  featuredExercises     String  @default("[]")
  showPowerliftingTotal Boolean @default(false)

}

model Bodyweight {
  id     Int      @id @default(autoincrement())
  date   DateTime @unique
  weight Float
}

model BodyMeasurement {
  id     Int      @id @default(autoincrement())
  date   DateTime @unique
  waist  Float?
  chest  Float?
  arms   Float?
  thighs Float?
  hips   Float?
}

model ExerciseTemplate {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  muscleGroup  String?
}

model FoodItemTemplate {
  id      Int    @id @default(autoincrement())
  name    String @unique
  kcal    Float
  protein Float
  carbs   Float
  fat     Float
}

model WorkoutTemplate {
  id        Int                       @id @default(autoincrement())
  name      String                    @unique
  exercises WorkoutTemplateExercise[]
}

model WorkoutTemplateExercise {
  id                Int                  @id @default(autoincrement())
  name              String
  workoutTemplateId Int
  workoutTemplate   WorkoutTemplate      @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  sets              WorkoutTemplateSet[]

  @@index([workoutTemplateId])
}

model WorkoutTemplateSet {
  id                        Int                     @id @default(autoincrement())
  weight                    Float
  reps                      Int
  rpe                       Float?
  workoutTemplateExerciseId Int
  workoutTemplateExercise   WorkoutTemplateExercise @relation(fields: [workoutTemplateExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutTemplateExerciseId])
}

model Program {
  id                 Int          @id @default(autoincrement())
  name               String       @unique
  weeks              Int
  // Percentages in the schemes are of this share of e1RM (e.g. 90 for a 5/3/1-style training max).
  trainingMaxPercent Float        @default(100)
  days               ProgramDay[]
}

model ProgramDay {
  id        Int               @id @default(autoincrement())
  dayNumber Int
  name      String?
  programId Int
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]

  @@index([programId])
}

model ProgramExercise {
  id           Int        @id @default(autoincrement())
  name         String
  order        Int        @default(0)
  // JSON array with one set scheme per week, e.g. ["5x5@75", "5x4@80", "1x1@90, 3x5@75"].
  weekSchemes  String
  programDayId Int
  programDay   ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)

  @@index([programDayId])
}
